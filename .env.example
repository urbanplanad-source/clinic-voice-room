DATABASE_URL="postgresql://clinic_voice_room:password@localhost:5432/clinic_voice_room"
SESSION_SECRET="replace-with-a-long-random-secret"
OPENAI_API_KEY="sk-replace-me"
OPENAI_TEXT_TRANSLATION_MODEL="gpt-5.2"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
OPENAI_STORE_TRANSLATION_MODEL="gpt-realtime-translate"
NUMBER_GUARD="on"
MEDIVOICE_HYBRID_TRANSLATION_MODE="low_risk_main"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
