# Required in production unless intentionally using the emergency bypass below.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# Optional emergency bypass only. Do not enable for production release.
ALLOW_IN_MEMORY_RATE_LIMIT_IN_PRODUCTION="false"

# Optional. Use only when self-hosting behind a trusted proxy outside Vercel.
TRUST_PROXY_HEADERS="false"

# Optional rollback only. Keep disabled in production after patientJoinCode rollout.
ALLOW_LEGACY_ROOM_TOKEN_LOOKUP="false"

CRON_SECRET="replace-with-a-long-random-cron-secret"
HOSPITAL_ACTIVE_ROOM_LIMIT="10"
ROOM_AUTO_END_MINUTES="5"
TRANSLATION_SAMPLE_RETENTION_DAYS="30"

