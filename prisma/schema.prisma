generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  partner_free
  external_trial
  external_paid
}

enum HospitalStatus {
  active
  suspended
}

enum HospitalSpecialty {
  dermatology
  plastic_surgery
  dental
  ophthalmology
  neurology
  oriental_medicine
  general
}

enum GlossaryScope {
  global
  specialty
  hospital
}

enum GlossaryEntryType {
  term
  critical_phrase
  transcription_hint
  verified_sentence
}

enum GlossaryLifecycleStatus {
  draft
  approved
  active
  retired
}

enum StaffRole {
  hospital_admin
  staff
  internal_admin
}

enum PatientLanguage {
  zh
  yue
  zh_tw
  ja
  en
  ru
  vi
  id
  th
  ms
  tl
  mn
  fr
  es
  de
  it
  pt
}

enum RoomStatus {
  waiting_for_patient
  ready
  staff_speaking
  translating_to_patient
  patient_listening
  patient_speaking
  translating_to_staff
  staff_listening
  ended
  error
}

enum RoomMode {
  consultation
  procedure
}

enum ParticipantRole {
  staff
  patient
}

enum FeedbackStatus {
  new
  reviewed
  fixed
  dismissed
}

enum ConnectionState {
  connected
  disconnected
}

model Hospital {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  planType                    PlanType                     @default(partner_free)
  status                      HospitalStatus               @default(active)
  specialty                   HospitalSpecialty            @default(dermatology)
  monthlyIncludedMinutes      Int?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  staffUsers                  StaffUser[]
  rooms                       TranslationRoom[]
  usageSessions               UsageSession[]
  localInterpreterUsageTurns  LocalInterpreterUsageTurn[]
  localInterpreterTurnMetrics LocalInterpreterTurnMetric[]
  textTranslationUsage        TextTranslationUsage[]
  glossaryEntries             GlossaryEntry[]
  quickPhrases                HospitalQuickPhrase[]
  translationFeedback         TranslationFeedback[]
  translationSamples          TranslationSample[]
  glossaryPackReleases        GlossaryPackRelease[]
}

model GlossaryEntry {
  id            String                  @id @default(cuid())
  scope         GlossaryScope
  specialty     HospitalSpecialty?
  hospitalId    String?
  hospital      Hospital?               @relation(fields: [hospitalId], references: [id])
  entryType     GlossaryEntryType       @default(term)
  spokenForms   String[]
  standardKo    String
  translations  Json
  category      String?
  note          String?
  priority      Int                     @default(100)
  isActive      Boolean                 @default(true)
  lineageId     String                  @default(cuid())
  version       Int                     @default(1)
  lifecycle     GlossaryLifecycleStatus @default(active)
  approvedById  String?
  approvedAt    DateTime?
  activatedById String?
  activatedAt   DateTime?
  retiredAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([lineageId, version])
  @@index([scope, specialty, isActive])
  @@index([hospitalId, isActive])
  @@index([lifecycle, updatedAt])
}

model GlossaryAuditEvent {
  id            String   @id @default(cuid())
  entryId       String
  lineageId     String
  version       Int
  hospitalId    String?
  actorStaffId  String
  actorRole     String
  action        String
  fromLifecycle String?
  toLifecycle   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entryId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([actorStaffId, createdAt])
}

model GlossaryPackRelease {
  id                   String             @id @default(cuid())
  hospitalId           String?
  hospital             Hospital?          @relation(fields: [hospitalId], references: [id])
  specialty            HospitalSpecialty?
  patientLanguage      PatientLanguage?
  direction            String?
  version              String             @unique
  status               String             @default("draft")
  normalizationVersion Int
  checksumSha256       String
  signature            String
  signatureAlgorithm   String             @default("Ed25519")
  signingKeyId         String
  minimumAppVersion    String?
  manifest             Json
  payload              Json
  createdById          String
  createdAt            DateTime           @default(now())
  activatedAt          DateTime?
  retiredAt            DateTime?

  @@index([hospitalId, status, createdAt])
  @@index([specialty, status, createdAt])
  @@index([patientLanguage, direction, status])
}

model HospitalQuickPhrase {
  id           String   @id @default(cuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  stage        String?
  ko           String
  translations Json
  sortOrder    Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hospitalId, isActive, sortOrder])
}

model StaffUser {
  id                          String                       @id @default(cuid())
  hospitalId                  String
  hospital                    Hospital                     @relation(fields: [hospitalId], references: [id])
  name                        String
  email                       String                       @unique
  passwordHash                String
  sessionVersion              Int                          @default(1)
  role                        StaffRole                    @default(staff)
  isActive                    Boolean                      @default(true)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  rooms                       TranslationRoom[]            @relation("RoomHost")
  usageSessions               UsageSession[]
  localInterpreterUsageTurns  LocalInterpreterUsageTurn[]
  localInterpreterTurnMetrics LocalInterpreterTurnMetric[]
  textTranslationUsage        TextTranslationUsage[]
  translationSamples          TranslationSample[]
}

model TranslationRoom {
  id                   String                @id @default(cuid())
  hospitalId           String
  hospital             Hospital              @relation(fields: [hospitalId], references: [id])
  hostStaffId          String
  hostStaff            StaffUser             @relation("RoomHost", fields: [hostStaffId], references: [id])
  patientLanguage      PatientLanguage
  roomMode             RoomMode              @default(consultation)
  roomToken            String                @unique
  patientJoinCode      String?               @unique
  status               RoomStatus            @default(waiting_for_patient)
  createdAt            DateTime              @default(now())
  lastActiveAt         DateTime              @default(now())
  patientJoinedAt      DateTime?
  endedAt              DateTime?
  participants         RoomParticipant[]
  usageSession         UsageSession?
  consultationMessages ConsultationMessage[]

  @@index([hospitalId, status, lastActiveAt])
}

model RoomParticipant {
  id              String          @id @default(cuid())
  roomId          String
  room            TranslationRoom @relation(fields: [roomId], references: [id])
  role            ParticipantRole
  joinedAt        DateTime        @default(now())
  leftAt          DateTime?
  connectionState ConnectionState @default(connected)

  @@index([roomId, role])
}

model UsageSession {
  id                     String          @id @default(cuid())
  hospitalId             String
  hospital               Hospital        @relation(fields: [hospitalId], references: [id])
  staffId                String
  staff                  StaffUser       @relation(fields: [staffId], references: [id])
  roomId                 String          @unique
  room                   TranslationRoom @relation(fields: [roomId], references: [id])
  patientLanguage        PatientLanguage
  roomStartedAt          DateTime
  roomEndedAt            DateTime?
  totalRoomSeconds       Int             @default(0)
  staffSpeakingSeconds   Int?
  patientSpeakingSeconds Int?
  translatedAudioSeconds Int?
  estimatedApiCostUsd    Decimal?        @db.Decimal(10, 4)
  createdAt              DateTime        @default(now())
}

model ConsultationMessage {
  id             String          @id @default(cuid())
  roomId         String
  room           TranslationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  speaker        ParticipantRole
  sourceText     String?
  text           String
  targetLanguage String?
  guardFlags     Json?
  createdAt      DateTime        @default(now())
  readAt         DateTime?

  @@index([roomId, createdAt])
}

model TranslationFeedback {
  id                 String         @id @default(cuid())
  hospitalId         String
  hospital           Hospital       @relation(fields: [hospitalId], references: [id])
  roomId             String?
  messageId          String?
  sourceText         String
  translatedText     String
  sourceTextHash     String?
  translatedTextHash String?
  redactionTypes     String[]       @default([])
  sourceLanguage     String
  targetLanguage     String
  reporterRole       String
  reason             String?
  status             FeedbackStatus @default(new)
  createdAt          DateTime       @default(now())
  reviewedAt         DateTime?

  @@index([hospitalId, status, createdAt])
}

model TranslationSample {
  id                 String           @id @default(cuid())
  hospitalId         String
  hospital           Hospital         @relation(fields: [hospitalId], references: [id])
  staffId            String?
  staff              StaffUser?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  roomId             String?
  messageId          String?
  source             String
  mode               String
  direction          String
  patientLanguage    PatientLanguage?
  sourceText         String
  translatedText     String
  sourceTextHash     String?
  translatedTextHash String?
  redactionTypes     String[]         @default([])
  retentionExpiresAt DateTime?
  sourceLanguage     String
  targetLanguage     String
  model              String?
  guardFlags         Json?
  status             FeedbackStatus   @default(new)
  createdAt          DateTime         @default(now())
  reviewedAt         DateTime?

  @@unique([hospitalId, source, messageId])
  @@index([hospitalId, status, createdAt])
  @@index([staffId, createdAt])
  @@index([source, createdAt])
  @@index([retentionExpiresAt])
}

model LocalInterpreterUsageTurn {
  id                       String          @id @default(cuid())
  hospitalId               String
  hospital                 Hospital        @relation(fields: [hospitalId], references: [id])
  staffId                  String
  staff                    StaffUser       @relation(fields: [staffId], references: [id])
  patientLanguage          PatientLanguage
  direction                String
  transport                String
  durationSeconds          Int             @default(0)
  sourceTextCharacters     Int?
  translatedTextCharacters Int?
  createdAt                DateTime        @default(now())

  @@index([hospitalId, createdAt])
  @@index([staffId, createdAt])
  @@index([patientLanguage, createdAt])
}

model LocalInterpreterTurnMetric {
  id                         String          @id
  hospitalId                 String
  hospital                   Hospital        @relation(fields: [hospitalId], references: [id])
  staffId                    String
  staff                      StaffUser       @relation(fields: [staffId], references: [id])
  patientLanguage            PatientLanguage
  direction                  String
  transport                  String
  outcome                    String
  resultReadyMs              Int?
  audioStartedMs             Int?
  validationMs               Int?
  validationStatus           String?
  corrected                  Boolean         @default(false)
  verifiedSentence           Boolean         @default(false)
  errorCategory              String?
  appVersion                 String?
  messageId                  String?
  packVersion                String?
  glossaryVersion            String?
  normalizationVersion       Int?
  modelId                    String?
  enginePath                 String?
  turnEndMode                String?
  speechEndToTranscriptMs    Int?
  requestRoundTripMs         Int?
  exactMatchMs               Int?
  glossaryMatchMs            Int?
  translationMs              Int?
  correctionMs               Int?
  totalMs                    Int?
  initialDeterministicStatus String?
  finalDeterministicStatus   String?
  semanticStatus             String?
  validationPath             String?
  riskLevel                  String?
  riskReasons                String[]        @default([])
  matchedEntryIds            String[]        @default([])
  modelAttemptCount          Int             @default(0)
  validationAttemptCount     Int             @default(0)
  correctionAttemptCount     Int             @default(0)
  strictAttemptCount         Int             @default(0)
  retryRequiredCount         Int             @default(0)
  estimatedCostUsd           Decimal?        @db.Decimal(10, 6)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([hospitalId, createdAt])
  @@index([staffId, createdAt])
  @@index([patientLanguage, createdAt])
  @@index([outcome, createdAt])
  @@index([packVersion, createdAt])
  @@index([semanticStatus, createdAt])
}

model TextTranslationUsage {
  id             String    @id @default(cuid())
  hospitalId     String
  hospital       Hospital  @relation(fields: [hospitalId], references: [id])
  staffId        String
  staff          StaffUser @relation(fields: [staffId], references: [id])
  sourceLanguage String
  targetLanguage String
  createdAt      DateTime  @default(now())

  @@index([hospitalId, createdAt])
  @@index([staffId, createdAt])
  @@index([sourceLanguage, targetLanguage, createdAt], map: "TextTranslationUsage_sourceLanguage_targetLanguage_createdAt_id")
}
